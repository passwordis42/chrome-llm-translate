{
  "name": "yifan",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "一翻 · Chromium MV3 扩展（Chrome / Edge），用千问、OpenAI、火山方舟、DeepSeek 或 Kimi 做划词，并在原文字位替换整页译文",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-reporter spec src/lib/*.test.ts",
    "verify": "node scripts/verify-dist.mjs",
    "smoke": "node scripts/smoke-extension.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run verify"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.9",
    "playwright-core": "^1.64.1",
    "sharp": "^0.34.1",
    "typescript": "^5.8.3"
  }
}
